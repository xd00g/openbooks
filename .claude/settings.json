{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(openssl *)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(mkdir *)",
      "Bash(./scripts/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ]
  }
}
