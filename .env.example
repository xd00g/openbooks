# ==========================================================================
# OpenBooks environment — copy to `.env` and fill in. NEVER commit `.env`.
# ==========================================================================

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost
API_PORT=3000
WEB_PORT=5173

# --- PostgreSQL ---
POSTGRES_USER=openbooks
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=openbooks
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# App RUNTIME role — NON-superuser so PostgreSQL RLS is actually enforced.
# (A superuser bypasses RLS entirely.) Created by scripts/create-app-role.sql
# after migration. Use its password here. See docs/DEPLOY.md.
DATABASE_URL=postgresql://openbooks_app:change-me-app@postgres:5432/openbooks?schema=public
# Privileged connection = the POSTGRES_USER superuser above. Used ONLY for
# migrations, applying the SQL constraints, and the app's onboarding/auth path
# (org/company creation must bypass RLS).
ADMIN_DATABASE_URL=postgresql://openbooks:change-me-postgres@postgres:5432/openbooks?schema=public

# --- Sessions (JWT) ---
# 32+ byte random secret: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-secret

# --- Redis / BullMQ ---
REDIS_URL=redis://redis:6379

# --- MinIO / S3 object storage (attachments) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=openbooks
S3_ACCESS_KEY=openbooks
S3_SECRET_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true

# --- App-layer field encryption (SSNs, bank tokens, EINs) ---
# 32-byte base64 key: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=change-me-generate-a-32-byte-key

# --- Auth (OIDC / Authentik). Optional for first run; see docs/AUTH.md ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback

# --- Auth (SAML 2.0). Optional; requires @node-saml/node-saml to fully enable ---
SAML_ENTRY_POINT=
SAML_ISSUER=openbooks
SAML_CERT=
SAML_CALLBACK_URL=http://localhost:3000/api/auth/saml/callback

# Break-glass local admin — seeded on first boot if no users exist.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# --- Bank feeds (optional) ---
BANK_FEED_DEFAULT_PROVIDER=file_import   # simplefin | plaid | file_import
SIMPLEFIN_SETUP_TOKEN=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- SMTP (invoices, notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="OpenBooks <no-reply@example.com>"
