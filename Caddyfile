# OpenBooks reverse proxy — fronted by a Cloudflare Tunnel (cloudflared).
# The tunnel terminates public TLS at Cloudflare's edge and reaches this origin
# over its own encrypted outbound connection, so Caddy serves plain HTTP here
# and just does path routing. cloudflared's public-hostname service should point
# at http://caddy:80.
http://books.nebulys.net, http://books.doogster.com {
	# API under /api/* — preserve the /api prefix (the API's global route prefix),
	# so use `handle` (not `handle_path`, which would strip it).
	handle /api/* {
		reverse_proxy api:3000
	}

	# Everything else -> web (Vite preview server)
	handle {
		reverse_proxy web:5173
	}

	encode gzip zstd
	log
}
